# Copiar este archivo a `.env.local` y completar los valores reales.
# `.env.local` está ignorado por Git — nunca subir secretos al repositorio.

# URL pública del sitio en el entorno actual (dev, staging, prod).
# Se usa para metadata absoluta, sitemap y OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# =====================================================================
# Supabase — conexión a la base de datos / Auth / Storage
# Dashboard → Connect (framework: Next.js) o Project Settings → API Keys
# =====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu-publishable-o-anon-key

# Solo server-side / scripts admin (NUNCA con prefijo NEXT_PUBLIC_).
# Hace falta solo para leer leads desde código o tareas privilegiadas.
# SUPABASE_SERVICE_ROLE_KEY=

# =====================================================================
# TODO: [LEADS] — webhook de automatización (n8n / Make / Zapier)
# En n8n, la URL de prueba es /webhook-test/... (solo funciona con
# "Listen for test event"). La URL productiva es /webhook/...
# =====================================================================
# LEADS_WEBHOOK_URL=http://localhost:5678/webhook/leads-suscriptores
# LEADS_API_KEY=

# =====================================================================
# TODO: [AUTH] — resuelto (commit 8b318cd): no hizo falta ninguna variable adicional.
# La autenticación de clientes usa Supabase Auth con las mismas
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY de arriba.
# =====================================================================

