# Copiar este archivo a `.env.local` y completar los valores reales.
# `.env.local` está ignorado por Git — nunca subir secretos al repositorio.

# URL pública del sitio en el entorno actual (dev, staging, prod).
# Se usa para metadata absoluta, sitemap y OpenGraph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

